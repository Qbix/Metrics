{
	"Q": {
		"pluginInfo": {
			"Metrics": {
				"version": "0.8",
				"compatible": "0.1",
				"requires": {
					"Q": "1.0"
				},
				"permissions": [],
				"connections": ["Metrics"]
			}
		},
		"handlersBeforeEvent": {
			"Users/User/lastActiveTime": ["Metrics/before/Users_User_lastActiveTime"]
		},
		"handlersAfterEvent": {
			"Q/metrics": ["Metrics/after/Q_metrics"]
		},
		"routes@end": {
			
		},
		"routes": {
		    
		},
		"web": {

		},
		"webserver": {
			"preload": [
				"Metrics", "Metrics_Visit", "Metrics_Hit", 
				"Metrics_Action", "Metrics_Tracker"
			]
		},
		"javascript": {

		},
		"environments": {
			"live": {
				"prepare": {
					"{{Metrics}}": ["js", "css"]
				}
			}
		},
		"text": {

		},
		"images": {

		}
	},
	"Users": {

	},
	"Streams": {
		"types": {
			
		}
	},
	"Metrics": {
		"action": {
			"id": {
				"length": 30
			}
		},
		"querystring": {
			"fields": {
				"trackerId": ["sourceId"]
			}
		},
		"visit": {
			"enrich": {
				"location": true
			}
		},
		"navigationTracker": {
			"sections": "h2[id], h3[id], section[id], [data-section]",
			"minSectionHeight": 100,
			"debounce": 1000,
			"initDelay": 800,
			"anchorCooldown": 1500,
			"depthMilestones": [25, 50, 75, 100],
			"sectionLookback": 300,
			"settleTolerance": 2,
			"recheckInterval": 500,
			"trackClicks": true,
			"trackUnload": true,
			"handleBfcache": true
		},
		"mediaTracker": {
			"checkpointInterval": 10,
			"autoDiscover": true,
			"reloadIframes": false,
			"observeDom": true
		}
	}
}
